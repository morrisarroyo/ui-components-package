{
  "name": "ehr-design-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/ui",
    "packages/app"
  ],
  "scripts": {
    "build": "npm run build --workspace ui && npm run build --workspace app",
    "dev": "npm run build --workspace ui && npm run dev --workspace app",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "api": "dotnet run --project api/Intrahealth.Api"
  },
  "engines": {
    "node": ">=20"
  }
}
